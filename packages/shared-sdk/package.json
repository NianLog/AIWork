{
  "name": "@ai-portal/shared-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "框架无关的子应用 SDK，包含宿主桥接与独立运行入口",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-portal/shared-types": "workspace:*"
  }
}
